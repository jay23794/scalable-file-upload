PORT=5000

# Zilliz Cloud (Milvus) — free tier serverless
ZILLIZ_URI=https://xxxxx.serverless.gcp-us-west1.cloud.zilliz.com
ZILLIZ_TOKEN=your-zilliz-api-token
MILVUS_COLLECTION=document_chunks

# HuggingFace model id served via @xenova/transformers (ONNX)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
