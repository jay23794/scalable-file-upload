SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNmYW5oYXNibXdtd2d1emFkcHl0Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTAxODIwOCwiZXhwIjoyMTAwNTk0MjA4fQ.rAyXDKnf9iReatXy2FUx7otIemYxR_hk6rGXX2RMIiw
SUPABASE_BUCKET=fbkt-ile-upload

# Shared secret for backend ↔ cf / ml calls to /internal/*
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# Queue names (must match cloud-function and ml)
OCR_QUEUE_NAME=ocr-queue
EMBED_QUEUE_NAME=embed-queue

# TTL for signed URLs handed to workers for the chunks/ prefix
CHUNKS_DOWNLOAD_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# find-job
# ---------------------------------------------------------------------------
SCRAPE_QUEUE_NAME=scrape-queue

# Apify. The token is the only new secret. Required before anything scrapes;
# stages 1-3 of the build run without it.
APIFY_TOKEN=

# Site -> actor id, as JSON. The keys are the set of sites that exist, so a
# board is added here rather than in code. Filled in once actors are chosen.
# e.g. {"linkedin":"bebity/linkedin-jobs-scraper","naukri":"some/naukri-actor"}
APIFY_ACTORS={}

APIFY_POLL_INTERVAL_MS=10000
# Sent to Apify, so Apify gives up first and hands us a real error.
APIFY_RUN_TIMEOUT_MS=600000
# Our own poll deadline. MUST exceed APIFY_RUN_TIMEOUT_MS -- checked at boot.
FINDJOB_POLL_DEADLINE_MS=900000
# Cost guard: every actor run is sent this cap. No cap means one bad query can
# produce an unbounded bill.
APIFY_MAX_ITEMS_PER_RUN=100

# These jobs wait on Apify rather than compute, so keep this at or above the
# number of sites or they run one after another for no reason.
FINDJOB_WORKER_CONCURRENCY=4

# Defaults to every key of APIFY_ACTORS when empty.
FINDJOB_DEFAULT_SITES=
# Spend controls: more terms and more results both mean a bigger bill.
FINDJOB_MAX_SEARCH_TERMS=3
FINDJOB_RESULTS_PER_SITE=50
FINDJOB_MAX_RESULTS_PER_SITE=100
FINDJOB_HOURS_OLD=168

# Site -> provider name. Unused until a second provider exists.
FINDJOB_SITE_OVERRIDES={}

# Postings go stale in weeks and the documents are large. The TTL is not
# optional -- without it the jobs collection grows forever.
RAW_JOB_TTL_DAYS=45
