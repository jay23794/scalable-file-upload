PORT=4000

# Redis (must match backend + ml)
REDIS_URL=redis://localhost:6379
OCR_QUEUE_NAME=ocr-queue
EMBED_QUEUE_NAME=embed-queue

# Backend API — used to mint signed URLs and delete staged chunks
BACKEND_BASE_URL=http://localhost:3000
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# BullMQ worker: in-flight jobs per process
WORKER_CONCURRENCY=5
