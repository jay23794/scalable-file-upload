PORT=4000

# Redis (must match backend's REDIS_URL and OCR_QUEUE_NAME)
REDIS_URL=redis://localhost:6379
OCR_QUEUE_NAME=ocr-queue

# Backend API (used for internal callbacks / signed-URL refresh if added later)
BACKEND_BASE_URL=http://localhost:3000

# ml service. On macOS host, use :5100 — AirPlay Receiver squats :5000.
# Inside docker-compose this is overridden to http://ml:5000.
ML_SERVICE_URL=http://localhost:5100

# BullMQ worker: in-flight jobs per process
WORKER_CONCURRENCY=5
